/secrets/
docker-compose.override.yml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; examples are allowed
.env
.env.*
!.env.example
!.env*.example

# supabase local
supabase/.temp
supabase/.branches

# extracted SRS scratch
_srs_extract.txt
_p7_srs.txt

# local database dumps (never commit)
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
DEPLOY.md
