# =============================================================================
# Niti Sabha — PRODUCTION environment (Vercel / hosted Supabase)
#
# Local copy for verify / bootstrap / db push:
#   cp .env.production.example .env.production
#   nano .env.production          # fill every value below
#   npm run env:verify:prod
#
# Also paste the same values into Vercel → Settings → Environment Variables.
# Never commit .env.production. Never use local demo Supabase keys here.
# =============================================================================

# --- Public app URL (browser + auth redirects) ---
NEXT_PUBLIC_APP_URL=https://technokautilya.in

# --- Hosted Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Leave empty in production (app uses NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_INTERNAL_URL=

# For migrations / bootstrap from your machine (Settings → Database → connection string).
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Mail (Brevo) ---
# QR credential emails — set BREVO_API_KEY. Auth verify/reset uses Supabase SMTP dashboard.
BREVO_API_KEY=xkeysib-...
MAIL_FROM=noreply@technokautilya.in
MAIL_FROM_NAME=Niti Sabha

# Must be empty in production (no Mailpit).
MAILPIT_URL=

# Comma-separated admin emails that cannot be deleted in the admin UI.
PROTECTED_ADMIN_EMAILS=you@technokautilya.in

# --- One-time bootstrap only (shell exports, not stored in this file) ---
# BOOTSTRAP_ADMIN_EMAIL=you@technokautilya.in
# BOOTSTRAP_ADMIN_PASSWORD=long-random-secret
# BOOTSTRAP_ADMIN_NAME=Secretariat
# npm run bootstrap:admin:prod
