{
  "name": "kautilya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "docker compose up supabase -d --build",
    "db:stop": "docker compose stop supabase && docker compose rm -f supabase",
    "db:reset": "npx supabase db reset",
    "db:status": "npx supabase status",
    "db:backup": "node scripts/backup.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "smoke": "node scripts/load-smoke.mjs",
    "bootstrap:admin": "node scripts/bootstrap-superadmin.mjs",
    "bootstrap:admin:prod": "node scripts/bootstrap-superadmin.mjs --production",
    "env:verify": "node scripts/verify-env.mjs",
    "env:verify:prod": "node scripts/verify-env.mjs --production",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:prod": "node scripts/compose-prod.mjs up --build",
    "compose:prod:detached": "node scripts/compose-prod.mjs up -d --build app-prod"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.2",
    "ogl": "^1.0.11",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-icons": "^5.7.0",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
