# =============================================================================
# Niti Sabha — LOCAL development environment
#
#   cp .env.example .env
#   # optional overrides (gitignored):
#   cp .env.example .env.local
#
# PowerShell: Copy-Item .env.example .env
#
# Production uses a separate env file — see `.env.production.example` and [DEPLOY.md](./DEPLOY.md).
# =============================================================================

# --- Next.js (browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Local Supabase CLI (default keys from `supabase start`) ---
