# =============================================================================
# Niti Sabha — LOCAL development environment
#
#   cp .env.example .env
#   # optional overrides (gitignored):
#   cp .env.example .env.local
#
# PowerShell: Copy-Item .env.example .env
#
# Production uses a separate env file — see `.env.production.example` and [DEPLOY.md](./DEPLOY.md).
# =============================================================================

# --- Next.js (browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Local Supabase CLI (default keys from `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# When the app runs inside Docker, it reaches Supabase on the host via:
SUPABASE_INTERNAL_URL=

DATABASE_URL=

# --- Mail (local only) ---
MAILPIT_URL=http://host.docker.internal:54324
# Leave empty locally unless testing Brevo:
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=

PROTECTED_ADMIN_EMAILS=

# --- Local seed logins only (supabase/seed.sql) — never use in production ---
# SUPER_ADMIN:  admin@kautilya.local     / KautilyaAdmin!26
# PARTICIPANT:  delegate@kautilya.local  / Delegate!26
