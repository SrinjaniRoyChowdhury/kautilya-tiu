# =============================================================================
# Kautilya MUN — environment variables
# Copy this file to `.env` and fill in values. Never commit `.env`.
#
# ZERO-BUDGET RULES
# - Use the Supabase Free plan (Auth + Postgres + Storage + Auth emails).
# - Run this Next.js app yourself via Docker or `npm run dev` (no paid host).
# - Local emails are captured by Inbucket (supabase start → port 54324).
# - Do NOT add Redis, Resend paid plans, R2, Sentry, Vercel Pro, or a
#   payment gateway. Those are out of v1 budget and out of SRS v1 scope.
# =============================================================================

# --- Required: Next.js ---
# Public origin of this app (used in auth redirect links).
# Local:  http://localhost:3000
# Docker-on-same-machine: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Required: Supabase (Auth + Postgres + Storage) ---
# How to get these:
# A) Local (recommended for development, ₹0):
#    1. Docker Desktop running
#    2. docker compose up --build   (or npm run db:start for Supabase only)
#    3. npx supabase status -o env
#    The local demo keys below match the official Supabase CLI defaults.
# B) Hosted Free project (₹0): https://supabase.com → New project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-only. Same project as the anon key. NEVER expose to the browser.
# Local CLI default is the demo service_role JWT below.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Optional. When Next.js runs inside Docker and Supabase runs on the host
# (`docker compose up`), the server must reach the API via this URL while
# the browser still uses NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Leave empty when Next.js and the browser share the same hostname.
SUPABASE_INTERNAL_URL=

# Direct Postgres URL. Used by `npx supabase` / optional SQL clients.
# Local CLI maps Postgres to host port 54322.
# Cloud Free: Project Settings → Database → URI (use the pooler URI if provided).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Optional: local credential email (Phase 4) ---
# Auth emails on hosted Free use Supabase's built-in (rate-limited) mailer.
# Local emails never leave your machine: open http://127.0.0.1:54324 (Mailpit).
# Custom SMTP is NOT required. If you later add a free SMTP, configure it in
# the Supabase dashboard — not here — so secrets stay on the Auth service.
#
# Mailpit HTTP send API for QR emails (₹0, local only). Leave empty to skip
# sending; the credential still appears at /dashboard/qr.
# Host Next.js:            http://127.0.0.1:54324
# Next.js in Docker:       http://host.docker.internal:54324
MAILPIT_URL=http://127.0.0.1:54324
MAIL_FROM=secretariat@kautilya.local

# --- Local seed logins (created by supabase/seed.sql, local only) ---
# SUPER_ADMIN:  admin@kautilya.local     / KautilyaAdmin!26
# PARTICIPANT:  delegate@kautilya.local  / Delegate!26
# Change both immediately if this stack is reachable by anyone else.
