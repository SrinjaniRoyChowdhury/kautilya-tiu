# =============================================================================
# Niti Sabha — environment variables
# Copy this file to `.env` and fill in values. Never commit `.env`.
#
# ZERO-BUDGET RULES
# - Supabase Free + Oracle Always Free (or similar) + Brevo free tier.
# - Local: Mailpit. Production: BREVO_API_KEY (QR mail) + Supabase SMTP (auth).
# =============================================================================

# --- Required: Next.js ---
# Local:  http://localhost:3000
# Live:   https://technokautilya.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Required: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Docker app → host Supabase
SUPABASE_INTERNAL_URL=

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Mail ---
# Local QR emails (leave empty in production):
MAILPIT_URL=http://127.0.0.1:54324
# Production QR emails (Brevo API). Auth verify/reset uses Supabase SMTP dashboard.
BREVO_API_KEY=
MAIL_FROM=secretariat@kautilya.local
MAIL_FROM_NAME=Niti Sabha

# Comma-separated emails that cannot be deleted in admin UI (live superadmin).
PROTECTED_ADMIN_EMAILS=

# --- Local seed logins only (supabase/seed.sql) — never use in production ---
# SUPER_ADMIN:  admin@kautilya.local     / KautilyaAdmin!26
# PARTICIPANT:  delegate@kautilya.local  / Delegate!26
#
# Production superadmin: run on the server after deploy
#   BOOTSTRAP_ADMIN_EMAIL=... BOOTSTRAP_ADMIN_PASSWORD=... npm run bootstrap:admin
